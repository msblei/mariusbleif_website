---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { profile } from "../data/profile";

import workshop1 from "../images/marius_workshop_1.jpg";
import workshop2 from "../images/marius_workshop_2.png";
import workshopBw from "../images/marius_BW_DIY_WS.png";
import portrait from "../images/office_background.png";
import travel1 from "../images/marius_privat_1.JPEG";
import travel2 from "../images/marius_privat_2.JPEG";
import travel3 from "../images/marius_privat_3.png";
import travel4 from "../images/marius_privat_4.JPG";

// Ordered to lead with trust (workshops in front of real audiences),
// then humanise. `cls` controls the mosaic tile size. Portrait-orientation
// photos go in tall slots and landscape photos in wide/square slots, so
// object-cover never crops through a face. The spans pack into a full 4x4
// block on desktop and an even 2-column block on mobile (no empty cells).
const photos = [
  { src: workshop1, alt: "Marius Bleif leading an AI workshop for a seminar audience", cls: "col-span-2 row-span-2", eager: true },
  { src: portrait, alt: "Portrait of Marius Bleif", cls: "row-span-2" },
  { src: travel2, alt: "Marius Bleif in front of a city skyline", cls: "row-span-2" },
  { src: travel3, alt: "Marius Bleif on a river boat", cls: "row-span-2" },
  { src: workshopBw, alt: "Marius Bleif explaining neural networks during a workshop", cls: "md:col-span-2" },
  { src: workshop2, alt: "Marius Bleif presenting to a professional group", cls: "" },
  { src: travel4, alt: "Marius Bleif hiking in the mountains", cls: "md:col-span-2" },
  { src: travel1, alt: "Marius Bleif while travelling", cls: "" },
];

// Machine-readable identity for search engines and AI agents. This is a
// recognised metadata standard (not hidden/cloaked text): the same facts are
// exposed to every user agent and mirror the visible/screen-reader content.
// All fields come from the shared profile (src/data/profile.ts).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.jobTitle,
  description: profile.bio,
  url: new URL("/", Astro.url).href,
  image: new URL(portrait.src, Astro.url).href,
  email: `mailto:${profile.email}`,
  knowsAbout: profile.knowsAbout,
  knowsLanguage: profile.knowsLanguage,
  alumniOf: profile.education.map((name) => ({
    "@type": "EducationalOrganization",
    name,
  })),
  sameAs: [profile.links.linkedin, profile.links.github],
};
---

<BaseLayout image={portrait.src}>
  <div id="sun-glow" class="sun-glow pointer-events-none fixed inset-0 z-0" aria-hidden="true"></div>

  <script type="application/ld+json" set:html={JSON.stringify(person)} />

  <div class="relative z-10">
  <header class="mb-10">
    <h1 class="text-5xl md:text-6xl tracking-tight">Marius Bleif</h1>
    <p class="text-2xl md:text-3xl mt-3 opacity-70">
      Consultant, AI, Cybersecurity, Strategy
    </p>
  </header>

  <!-- Visually hidden, but present for screen readers and crawlers/agents. -->
  <section class="sr-only">
    <h2>About {profile.name}</h2>
    <p>{profile.bio}</p>
    <p>
      Contact:
      <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
      <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
      <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
    </p>
  </section>

  <div
    class="grid grid-cols-2 md:grid-cols-4 auto-rows-[9rem] sm:auto-rows-[11rem] md:auto-rows-[13rem] gap-3 [grid-auto-flow:dense]"
  >
    {
      photos.map((p) => (
        <figure
          class={`group relative overflow-hidden rounded-lg ring-1 ring-white/5 ${p.cls}`}
        >
          <Image
            src={p.src}
            alt={p.alt}
            width={1000}
            loading={p.eager ? "eager" : "lazy"}
            class="h-full w-full object-cover grayscale brightness-90 transition duration-700 ease-out group-hover:grayscale-0 group-hover:brightness-100 group-hover:scale-[1.04]"
          />
        </figure>
      ))
    }
  </div>

  <!-- Projects, from profile.projects. Icons are each project's own tile
       drawing (kladdle's from kladdle.com/branding, Food Autonomy Atlas's
       its favicon), used unaltered. -->
  <section class="mt-16 md:mt-20 text-center" aria-labelledby="building">
    <h2 id="building" class="text-2xl md:text-3xl opacity-70">building</h2>
    <ul class="mt-6 inline-flex flex-col items-start gap-6 list-none p-0 text-left">
      {
        profile.projects.map((p) => (
          <li>
            <a
              href={p.url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-3 opacity-70 transition hover:opacity-100"
            >
              <img src={p.icon} alt="" width="36" height="36" class="shrink-0" />
              <span class="text-xl">{p.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  </div>

  <style>
    .sun-glow {
      --sun-x: 50%;
      --sun-y: 38%;
      --sun-size: 18rem;
      opacity: 0;
      background: radial-gradient(
        circle var(--sun-size) at var(--sun-x) var(--sun-y),
        rgba(255, 184, 96, 0.28),
        rgba(255, 140, 52, 0.1) 42%,
        rgba(255, 120, 40, 0) 70%
      );
      will-change: opacity;
    }

    /* No motion / no JS: show a gentle static glow instead. */
    @media (prefers-reduced-motion: reduce) {
      .sun-glow {
        opacity: 0.2;
      }
    }
  </style>

  <script>
    const glow = document.getElementById("sun-glow");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (glow && !reduce) {
      let w = window.innerWidth;
      let h = window.innerHeight;
      let tx = w * 0.5; // target position
      let ty = h * 0.38;
      let cx = tx; // current (eased) position
      let cy = ty;
      let boost = 0; // temporary lift from cursor movement
      let lastX = tx;
      let lastY = ty;
      let lastMove = -Infinity; // timestamp of last pointer move
      let usingMouse = false; // once a real mouse moves, stop autonomous drift
      const start = performance.now();

      window.addEventListener("resize", () => {
        w = window.innerWidth;
        h = window.innerHeight;
      });

      window.addEventListener(
        "pointermove",
        (e) => {
          tx = e.clientX;
          ty = e.clientY;
          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          lastMove = performance.now();
          if (e.pointerType === "mouse") usingMouse = true;
          boost = Math.min(1, boost + Math.min(0.35, Math.hypot(dx, dy) / 450));
        },
        { passive: true }
      );

      const frame = (now) => {
        const elapsed = (now - start) / 1000;

        // Slow "sunrise": ease brightness up to full over ~38s.
        const rise = Math.min(1, elapsed / 38);
        const eased = 1 - Math.pow(1 - rise, 2);

        // Autonomous drift only on touch devices / before any mouse is used.
        // With a mouse, the glow stays put when idle instead of wandering off.
        const idle = now - lastMove > 2500;
        if (idle && !usingMouse) {
          tx = w * (0.5 + 0.28 * Math.sin(elapsed * 0.09));
          ty = h * (0.42 + 0.16 * Math.sin(elapsed * 0.065 + 1.3));
        }

        // Lazily ease the visible glow toward the target.
        cx += (tx - cx) * 0.03;
        cy += (ty - cy) * 0.03;
        boost *= 0.97; // decay the movement boost

        // Gentle, slow pulsation (~11s period) so the sun softly throbs.
        const pulse = Math.sin(elapsed * 0.55);
        const intensity = Math.max(
          0,
          Math.min(1, eased * (0.6 + boost * 0.5) + 0.08 * pulse * eased)
        );
        const size = 14 + eased * 16 + boost * 6 + pulse * 0.9 * eased; // rem — grows as it rises and pulses

        glow.style.setProperty("--sun-x", cx + "px");
        glow.style.setProperty("--sun-y", cy + "px");
        glow.style.setProperty("--sun-size", size + "rem");
        glow.style.opacity = intensity.toFixed(3);

        requestAnimationFrame(frame);
      };

      requestAnimationFrame(frame);
    }
  </script>
</BaseLayout>
