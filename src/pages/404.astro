---
import BaseLayout from "../layouts/BaseLayout.astro";
import SunGlow from "../components/SunGlow.astro";
import { profile } from "../data/profile";

const title = `Page not found | ${profile.name}`;
---

<BaseLayout title={title} description="This page doesn't exist.">
  <SunGlow riseSeconds={8} />

  <div class="relative z-10">
    <header class="mb-10">
      <h1 class="text-5xl md:text-6xl tracking-tight">404</h1>
      <p class="text-2xl md:text-3xl mt-3 opacity-70">
        This page doesn't exist.
      </p>
    </header>

    <a href="/" class="btn btn-accent">&larr; back to mariusbleif.com</a>
  </div>
</BaseLayout>
