---
// Icon + name link list used by the "building" and "teaching" sections of
// the home page. Icons are each entry's own square tile, used unaltered.
interface Props {
  id: string;
  heading: string;
  items: { name: string; url: string; icon: string }[];
}
const { id, heading, items } = Astro.props;
---

<section class="mt-16 md:mt-20 text-center" aria-labelledby={id}>
  <h2 id={id} class="text-2xl md:text-3xl opacity-70">{heading}</h2>
  <ul class="mt-6 inline-flex flex-col items-start gap-6 list-none p-0 text-left">
    {
      items.map((p) => (
        <li>
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-3 opacity-70 transition hover:opacity-100"
          >
            <img src={p.icon} alt="" width="36" height="36" class="shrink-0" />
            <span class="text-xl">{p.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
